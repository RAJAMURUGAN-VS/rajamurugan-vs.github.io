# GitHub Personal Access Token (read:user scope only)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# EmailJS — contact form (client-side, works on GitHub Pages)
# Sign up free at https://www.emailjs.com
# Service ID:  Dashboard → Email Services → your service
# Template ID: Dashboard → Email Templates → your template
# Public Key:  Dashboard → Account → Public Key
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
